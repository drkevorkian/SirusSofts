# Hestia sirussofts.com HTTPS vhost, AI only; no conflict with /Gentoo/live.
location = /Gentoo/AI { return 308 /Gentoo/AI/; }

# Protected inbound requests to Gentoo: dedicated SSH input connection.
location ^~ /Gentoo/AI/api/in/ {
    auth_basic "SirusSofts AI";
    auth_basic_user_file /etc/sirus-ai-dual/users.htpasswd;
    client_max_body_size 128k;
    proxy_pass http://127.0.0.1:18485/api/in/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_cache off;
}

# The output collector's private ingestion API MUST NOT be web-accessible.
location ^~ /Gentoo/AI/internal/ { return 404; }

# Public-facing (authenticated) frontend + server-sent events on Ubuntu.
# Gentoo sends model outputs INTO this process via its separate -L tunnel.
location ^~ /Gentoo/AI/ {
    auth_basic "SirusSofts AI";
    auth_basic_user_file /etc/sirus-ai-dual/users.htpasswd;
    proxy_pass http://127.0.0.1:18483/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 75s;
    proxy_send_timeout 30s;
    proxy_buffering off;
    proxy_cache off;
}
