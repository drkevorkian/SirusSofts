# HTTPS AI application only. The public UI is password-free; all state-changing
# API operations are routed through the CMS identity, CSRF and rate-limit layer.
location = /Gentoo/AI { return 308 /Gentoo/AI/; }

# Never expose raw Gentoo input queues, output event feeds or private ingestion.
# These services must only be called by the CMS over 127.0.0.1.
location ^~ /Gentoo/AI/api/ { return 404; }
location ^~ /Gentoo/AI/internal/ { return 404; }

# Static UI lives on the loopback output gateway. No HTTP Basic auth for chat.
location ^~ /Gentoo/AI/ {
    auth_basic off;
    limit_except GET HEAD { deny all; }
    proxy_pass http://127.0.0.1:18483/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_cache off;
}
