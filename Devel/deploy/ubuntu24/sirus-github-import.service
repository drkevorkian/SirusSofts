[Unit]
Description=SirusSofts private GitHub repository metadata importer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sirusweb
Group=sirusweb
UMask=0077
LoadCredential=github_token:/etc/sirussofts/github.token
ExecStart=/usr/bin/python3 /usr/local/libexec/sirus-github-import.py --db /home/sirusweb/web/sirussofts.com/private/sirus-cms/data/cms.sqlite3 --token-file %d/github_token
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/home/sirusweb/web/sirussofts.com/private/sirus-cms/data
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=1800
