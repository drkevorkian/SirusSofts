[Unit]
Description=SirusSofts Restricted Plesk Virtual Host Agent (Unix socket only)
After=local-fs.target
ConditionPathIsDirectory=/var/www/vhosts/sirussofts.com/httpdocs

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/sirusdeploy/vhost_agent.py serve
Restart=on-failure
RestartSec=5
RuntimeDirectory=sirus-vhost
RuntimeDirectoryMode=0751
StateDirectory=sirus-vhost
StateDirectoryMode=0700
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
