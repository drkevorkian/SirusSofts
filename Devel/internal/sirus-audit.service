[Unit]
Description=SirusSofts internal read-only security audit
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=-/etc/sirus-audit/github.env
ExecStart=/usr/bin/python3 /opt/sirus-audit/agent.py --output /var/lib/sirus-audit/latest.json --upload-if-configured
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sirus-audit

[Install]
WantedBy=multi-user.target
