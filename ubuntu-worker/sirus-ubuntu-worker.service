[Unit]
Description=SirusSofts allowlisted Ubuntu work executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sirusweb
Group=sirusweb
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/libexec/sirus-ubuntu-worker.py --interval 4
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/home/sirusweb/web/sirussofts.com/private/sirus-cms/nodes
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=96M
LimitNOFILE=128

[Install]
WantedBy=multi-user.target
