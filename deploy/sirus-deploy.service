[Unit]
Description=SirusSofts GitHub Push Deployment Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sirusdeploy
Group=sirusdeploy
WorkingDirectory=/opt/sirusdeploy
ExecStart=/usr/bin/python3 /opt/sirusdeploy/sirus_deploy.py serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/sirussofts/sites /var/lib/sirusdeploy
ReadOnlyPaths=/etc/sirusdeploy
UMask=0022

[Install]
WantedBy=multi-user.target
