#!/sbin/openrc-run
name="SirusSofts persistent HTTPS web reverse tunnel"
supervisor=supervise-daemon
command="/usr/bin/python3"
command_args="/opt/sirus-gentoo-node/tunnel.py --config /etc/sirus-gentoo-node/tunnel.json"
command_user="sirusnode:sirusnode"
respawn_delay=5
respawn_max=0
depend() {
    need net
}
